global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # No "master-worker" here: it is deprecated since HAProxy 3.3. The packaged
    # systemd unit already starts HAProxy in master-worker mode (-Ws).

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

# Data Plane API Frontend
frontend dataplane_api
    bind *:{{ dataplaneapi_tls_port }} ssl crt {{ dataplaneapi_certs_dir }}/api.pem
    mode http
    http-request auth unless { http_auth(api_users) }
    default_backend dataplane_api_backend

backend dataplane_api_backend
    mode http
    server dataplane 127.0.0.1:{{ dataplaneapi_port }}

userlist api_users
    user {{ dataplaneapi_user }} password {{ dataplaneapi_password_hash }}

# Application frontends and backends
frontend http_front
    bind *:80
    bind *:443 ssl crt {{ dataplaneapi_certs_dir }}/
    default_backend web_servers

backend web_servers
    balance roundrobin
    option httpchk GET /health
{% for server in dataplaneapi_web_servers %}
    server {{ server.name }} {{ server.address }} check
{% endfor %}
